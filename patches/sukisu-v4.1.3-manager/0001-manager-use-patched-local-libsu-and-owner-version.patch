From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chinohana <chinohana@outlook.com>
Date: Mon, 27 Jul 2026 22:35:00 +0800
Subject: [PATCH] manager: use patched local libsu and owner version

Resolve the owner-only libsu build from Maven Local before public
repositories.  Give the paired manager a deterministic version code and
an explicit version name without depending on a full upstream history.
---
 manager/build.gradle.kts            |  5 +++--
 manager/gradle/libs.versions.toml    |  2 +-
 manager/settings.gradle.kts          |  3 +++
 3 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/manager/build.gradle.kts b/manager/build.gradle.kts
index 0000000..0000000 100644
--- a/manager/build.gradle.kts
+++ b/manager/build.gradle.kts
@@ -12,8 +12,9 @@ val androidBuildToolsVersion by extra("37.0.0")
 val androidCompileNdkVersion: String by extra(libs.versions.ndk.get())
 val androidSourceCompatibility by extra(JavaVersion.VERSION_21)
 val androidTargetCompatibility by extra(JavaVersion.VERSION_21)
-val managerVersionCode by extra(getVersionCode())
-val managerVersionName by extra(getVersionName())
+val ownerPatchedManager = System.getenv("KSU_OWNER_PATCHED_MANAGER") == "1"
+val managerVersionCode by extra(if (ownerPatchedManager) System.getenv("KSU_OWNER_VERSION_CODE").toInt() else getVersionCode())
+val managerVersionName by extra(if (ownerPatchedManager) "v4.1.3-owner-libsu-readonly" else getVersionName())
 
 fun getGitCommitCount(): Int {
     val process = Runtime.getRuntime().exec(arrayOf("git", "rev-list", "--count", "HEAD"))
diff --git a/manager/gradle/libs.versions.toml b/manager/gradle/libs.versions.toml
index 0000000..0000000 100644
--- a/manager/gradle/libs.versions.toml
+++ b/manager/gradle/libs.versions.toml
@@ -26,6 +26,6 @@ material3 = "1.5.0-alpha19"
 materialKolor = "4.1.1"
 ndk = "29.0.14206865"
-libsu = "6.0.0"
+libsu = "6.0.0-owner-readonly"
 apksign = "1.4"
 miuix = "0.9.1"
 okhttp = "5.3.2"
diff --git a/manager/settings.gradle.kts b/manager/settings.gradle.kts
index 0000000..0000000 100644
--- a/manager/settings.gradle.kts
+++ b/manager/settings.gradle.kts
@@ -10,6 +10,9 @@ pluginManagement {
 
 dependencyResolutionManagement {
     repositories {
+        mavenLocal {
+            content { includeGroup("com.github.topjohnwu.libsu") }
+        }
         google()
         mavenCentral()
         maven("https://jitpack.io")
-- 
2.53.0.windows.2
